{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"globalEnv": [
		"DATABASE_URL",
		"JWT_SECRET",
		"CORS_ORIGINS",
		"PORT",
		"MBT_API_URL",
		"NEXT_PUBLIC_API_URL",
		"NEXT_PUBLIC_APP_URL",
		"NEXT_PUBLIC_ENV"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
