{
	"name": "my-turborepo",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"build:api": "turbo run build --filter=mbt-api",
		"build:app": "cd apps/webapp-mbt && node node_modules/next/dist/bin/next build --webpack",
		"db:validate": "prisma validate --schema packages/database/prisma/schema.prisma",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types",
		"db:setup": "node --env-file-if-exists=.env packages/database/setup-demo.mjs",
		"demo:sacbe": "pnpm --filter webapp-mbt demo:sacbe"
	},
	"devDependencies": {
		"prettier": "^3.6.2",
		"turbo": "^2.5.5",
		"typescript": "5.8.3"
	},
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": "22.x"
	}
}
