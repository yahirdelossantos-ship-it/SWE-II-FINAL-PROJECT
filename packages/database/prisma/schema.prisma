generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
	url      = env("DATABASE_URL")
}

model Employee {
	id              String        @id @default(cuid())
	name            String
	email           String?       @unique
	identification  String?       @unique
	role            EmployeeRole
	state           EmployeeState @default(WORKING)
	photo           String?
	darkMode        Boolean       @default(false)
	minimized       Boolean       @default(false)
	background      String?
	createdAt       DateTime      @default(now())
	updatedAt       DateTime      @updatedAt
	accessKey       AccessKey?
	servicesCreated Service[]
}

model AccessKey {
	id         String   @id @default(cuid())
	key        String
	employeeId String   @unique
	employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Itinerary {
	id        String    @id @default(cuid())
	date      DateTime  @unique
	createdAt DateTime  @default(now())
	updatedAt DateTime  @updatedAt
	services  Service[]
}

model Service {
	id                   String      @id @default(cuid())
	code                 String
	kindOf               ServiceType
	clientName           String
	pickupTime           DateTime
	originalPickupTime   DateTime
	pickupTimeModifiedAt DateTime?
	pax                  Int
	luggage              Int?
	flightCode           String?
	note                 String?
	pickupLocationName   String?
	dropoffLocationName  String?
	pickupDisplayName    String?
	dropoffDisplayName   String?
	vehicleTypeName      String?
	createdAt            DateTime    @default(now())
	updatedAt            DateTime    @updatedAt

	itineraryId String
	createdById String
	allyId      String?
	pickupId    String?
	dropoffId   String?
	vehicleId   String?

	itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Restrict)
	createdBy Employee  @relation(fields: [createdById], references: [id], onDelete: Restrict)
	ally      Ally?     @relation(fields: [allyId], references: [id], onDelete: SetNull)
	vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
	pickup    Place?    @relation("ServicePickup", fields: [pickupId], references: [id], onDelete: Restrict)
	dropoff   Place?    @relation("ServiceDropoff", fields: [dropoffId], references: [id], onDelete: Restrict)

	@@unique([code, kindOf])
	@@index([itineraryId, pickupTime])
	@@index([createdById])
}

model Place {
	id         String    @id @default(cuid())
	kind       PlaceKind
	name       String
	iata       String?   @unique @db.VarChar(3)
	pickupFor  Service[] @relation("ServicePickup")
	dropoffFor Service[] @relation("ServiceDropoff")

	@@index([kind, name])
}

model Ally {
	id       String    @id @default(cuid())
	name     String    @unique
	color    String?
	services Service[]
}

model Vehicle {
	id       String    @id @default(cuid())
	name     String
	services Service[]

	@@index([name])
}

enum ServiceType {
	ARRIVAL
	DEPARTURE
	TRANSFER
}

enum EmployeeRole {
	ADMINISTRATOR
	COORDINATOR
	MANAGER
}

enum EmployeeState {
	WORKING
	SUSPENDED
	FIRED
}

enum PlaceKind {
	AIRPORT
	HOTEL
	OTHER
	RESORT
	BEACH
	CLUB
	RESTAURANT
	MARINA
	RESIDENCE
	CONDO
	RESIDENTIAL
	VILLAS
	BAR
	APARTHOTEL
	APARTMENT
	AIRBNB
}
